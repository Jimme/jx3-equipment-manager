# Compose only. Local PowerShell startup uses data/ by default.
JX3_BIND_IP=0.0.0.0
JX3_PORT=8088
# Relative to the NAS project directory; never point this at a Windows path.
JX3_HOST_DATA_DIR=./data
# Startup prepares this application's data mount, then runs the service as this user.
JX3_UID=10001
JX3_GID=10001
